generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

/// How often a user wants due items emailed to them. ASAP means the next
/// scheduler pass, not instantly — delivery is bounded by NOTIFY_INTERVAL_MINUTES.
enum EmailDigest {
  OFF
  ASAP
  DAILY
  WEEKLY
}

enum PropertyType {
  HOUSE
  CONDO
  TOWNHOUSE
  LOT
  OTHER
}

enum AssetType {
  PROPERTY
  VEHICLE
  EQUIPMENT
}

enum EquipmentCategory {
  APPLIANCE
  HVAC
  WATER
  ELECTRONICS
  TOOL
  OUTDOOR
  SECURITY
  OTHER
}

enum AttachmentRecordType {
  SERVICE
  WARRANTY
  MAINTENANCE
}

enum NotificationType {
  MAINTENANCE_DUE
  WARRANTY_EXPIRING
  CUSTOM
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              Role     @default(USER)
  mustResetPassword Boolean  @default(false)
  createdAt         DateTime @default(now())

  emailDigest   EmailDigest @default(DAILY)
  /// When this user was last emailed, so a cadence can be measured from it.
  lastDigestAt  DateTime?

  notifications  Notification[]
  serviceRecords ServiceRecord[]
  attachments    Attachment[]
}

// ─── Assets ───────────────────────────────────────────────────────────────────

model Property {
  id            String       @id @default(cuid())
  name          String
  type          PropertyType @default(HOUSE)
  address       String
  purchaseDate  DateTime?
  purchasePrice Float?
  yearBuilt     Int?
  sqFt          Int?
  notes         String?
  imageFilename String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  equipment Equipment[]
}

model Vehicle {
  id             String    @id @default(cuid())
  name           String
  make           String
  model          String
  year           Int
  vin            String?
  color          String?
  purchaseDate   DateTime?
  currentMileage Int?
  notes          String?
  imageFilename  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Equipment {
  id            String            @id @default(cuid())
  name          String
  category      EquipmentCategory @default(APPLIANCE)
  manufacturer  String?
  modelNumber   String?
  serialNumber  String?
  location      String?
  purchaseDate  DateTime?
  purchasePrice Float?
  installDate   DateTime?
  notes         String?
  imageFilename String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}

// ─── Service Records ──────────────────────────────────────────────────────────

model ServiceRecord {
  id               String    @id @default(cuid())
  assetId          String
  assetType        AssetType
  date             DateTime
  title            String
  description      String?
  vendor           String?
  cost             Float?
  mileageAtService Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  attachments Attachment[]
}

// ─── Warranties ───────────────────────────────────────────────────────────────

model Warranty {
  id             String    @id @default(cuid())
  assetId        String
  assetType      AssetType
  productName    String
  purchaseDate   DateTime?
  expirationDate DateTime?
  vendor         String?
  vendorPhone    String?
  vendorEmail    String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attachments Attachment[]
}

// ─── Maintenance ──────────────────────────────────────────────────────────────

model MaintenanceSchedule {
  id                   String    @id @default(cuid())
  assetId              String
  assetType            AssetType
  title                String
  description          String?
  intervalDays         Int?
  intervalMiles        Int?
  lastCompletedDate    DateTime?
  lastCompletedMileage Int?
  nextDueDate          DateTime?
  nextDueMileage       Int?
  reminderDaysBefore   Int       @default(14)
  reminderMilesBefore  Int       @default(500)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  attachments Attachment[]
}

// ─── Attachments ──────────────────────────────────────────────────────────────

model Attachment {
  id           String               @id @default(cuid())
  recordType   AttachmentRecordType
  filename     String               // UUID-based name stored on disk
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime             @default(now())

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  serviceRecordId       String?
  serviceRecord         ServiceRecord?       @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  warrantyId            String?
  warranty              Warranty?            @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  maintenanceScheduleId String?
  maintenanceSchedule   MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id], onDelete: Cascade)
}

// ─── Mail settings ────────────────────────────────────────────────────────────

/// Single row (id is always "singleton"). Anything set here overrides the
/// matching SMTP_* environment variable, so an existing compose file keeps
/// working and the UI can override it without a container restart.
model MailSettings {
  id          String   @id @default("singleton")
  host        String?
  port        Int?
  username    String?
  /// AES-256-GCM, keyed from AUTH_SECRET — see lib/secret-box.ts. Never leaves
  /// the server; the UI is only told whether one is stored.
  passwordEnc String?
  /// null means "decide from the port", matching the env behaviour.
  secure      Boolean?
  fromAddress String?
  digestHour  Int?
  updatedAt   DateTime @updatedAt
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id                String           @id @default(cuid())
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime         @default(now())
  /// Set once this notification has gone out in a digest email. Null means it
  /// is still pending delivery, so a failed send is simply retried next pass.
  emailedAt         DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
